{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "public/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/scan.html", "dest": "/public/scan.html" },
    { "src": "/bonus.html", "dest": "/public/bonus.html" },
    { "src": "/api/(.*)", "dest": "/api/server.js" }
  ]
}
